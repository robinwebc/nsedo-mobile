---
import Logo from './Logo.astro';
import Text from './Text.astro';
import { page } from '../data/site';

const links = [
  { href: '/phones/', en: 'Phones', bn: 'ফোন' },
  { href: '/compare/', en: 'Compare', bn: 'তুলনা' },
  { href: '/support/', en: 'Support', bn: 'সহায়তা' },
  { href: '/about/', en: 'About', bn: 'পরিচিতি' },
  { href: '/news/', en: 'News', bn: 'খবর' },
];

const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

function currentFor(pathname: string): 'page' | undefined {
  const target = page(pathname);
  if (pathname === '/') return current === target ? 'page' : undefined;
  return current === target || current.startsWith(target) ? 'page' : undefined;
}
---
<a class="skip" href="#main"><Text en="Skip to content" bn="বিষয়ে যান" /></a>
<header class="site-header">
  <div class="bar wrap">
    <a class="logo-link" href={page('/')} aria-label="nSedo Mobile, home">
      <Logo />
    </a>
    <nav class="primary" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a href={page(link.href)} aria-current={currentFor(link.href)}>
              <Text en={link.en} bn={link.bn} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lang" role="group" aria-label="Language">
      <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
      <button type="button" data-set-lang="bn" lang="bn" aria-pressed="false">বাংলা</button>
    </div>
  </div>
</header>
