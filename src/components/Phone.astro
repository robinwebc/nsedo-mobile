---
import Text from './Text.astro';
import type { Lang, Tone } from '../data/phones';

interface Props {
  uid: string;
  view: 'front' | 'back';
  back: string;
  chassis: string;
  tone: Tone;
  cameras?: 1 | 2 | 3;
  label: Lang;
}

const { uid, view, back, chassis, tone, cameras = 3, label } = Astro.props;

const body = { x: 16, y: 8, w: 228, h: 524, rx: 46 };
const inset = { x: 24, y: 16, w: 212, h: 508, rx: 38 };
const button = tone === 'light' ? '#6E675C' : '#C9CED4';
const antenna = tone === 'light' ? 'rgba(20,32,43,0.45)' : 'rgba(244,241,235,0.32)';
const word = tone === 'light' ? '#14202B' : '#F4F1EB';

const firstCy = 74;
const gap = 48;
const centres = Array.from({ length: cameras }, (_, index) => firstCy + index * gap);
const island = { x: 36, y: 34, w: 108, h: centres[centres.length - 1] - 34 + 58, rx: 30 };
---
<div class="device">
  <svg viewBox="0 0 260 540" aria-hidden="true">
    <defs>
      <linearGradient id={`${uid}-metal`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffffff" stop-opacity={tone === 'light' ? '0.55' : '0.16'}></stop>
        <stop offset="0.18" stop-color="#ffffff" stop-opacity="0"></stop>
        <stop offset="0.82" stop-color="#000000" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#000000" stop-opacity={tone === 'light' ? '0.16' : '0.38'}></stop>
      </linearGradient>
      <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity={tone === 'light' ? '0.42' : '0.2'}></stop>
        <stop offset="0.42" stop-color="#ffffff" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#000000" stop-opacity={tone === 'light' ? '0.08' : '0.28'}></stop>
      </linearGradient>
      <linearGradient id={`${uid}-wall`} x1="0" y1="0" x2="0.2" y2="1">
        <stop offset="0" stop-color="#24323C"></stop>
        <stop offset="0.55" stop-color="#14202B"></stop>
        <stop offset="1" stop-color="#3C261E"></stop>
      </linearGradient>
      <radialGradient id={`${uid}-glow`} cx="78%" cy="86%" r="58%">
        <stop offset="0" stop-color="#E4572E" stop-opacity="0.7"></stop>
        <stop offset="0.55" stop-color="#E4572E" stop-opacity="0.18"></stop>
        <stop offset="1" stop-color="#E4572E" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id={`${uid}-clip`}>
        <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx={inset.rx}></rect>
      </clipPath>
    </defs>

    <rect x="8" y="118" width="8" height="32" rx="2" fill={button}></rect>
    <rect x="8" y="158" width="8" height="52" rx="2" fill={button}></rect>
    <rect x="244" y="146" width="8" height="70" rx="2" fill={button}></rect>

    <rect x={body.x} y={body.y} width={body.w} height={body.h} rx={body.rx} fill={chassis}></rect>
    <rect x={body.x} y={body.y} width={body.w} height={body.h} rx={body.rx} fill={`url(#${uid}-metal)`}></rect>
    <rect x="16" y="66" width="10" height="2.5" fill={antenna}></rect>
    <rect x="234" y="66" width="10" height="2.5" fill={antenna}></rect>
    <rect x="16" y="472" width="10" height="2.5" fill={antenna}></rect>
    <rect x="234" y="472" width="10" height="2.5" fill={antenna}></rect>

    {view === 'back' ? (
      <>
        <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx={inset.rx} fill={back}></rect>
        <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx={inset.rx} fill={`url(#${uid}-sheen)`}></rect>
        <rect x={island.x} y={island.y} width={island.w} height={island.h} rx={island.rx} fill="#121416"></rect>
        <rect x={island.x + 1} y={island.y + 1} width={island.w - 2} height={island.h - 2} rx={island.rx - 1} fill="none" stroke="#ffffff" stroke-opacity="0.08"></rect>
        {centres.map((cy) => (
          <g>
            <circle cx="74" cy={cy} r="21" fill="#1A1D21"></circle>
            <circle cx="74" cy={cy} r="18.6" fill="none" stroke="#8B9198" stroke-width="0.7"></circle>
            <circle cx="74" cy={cy} r="15.6" fill="#050607"></circle>
            <circle cx="74" cy={cy} r="10.5" fill="#10141A"></circle>
            <path d={`M66 ${cy - 7} a 9 9 0 0 1 13 -1`} fill="none" stroke="#ffffff" stroke-width="1.3" stroke-opacity="0.38" stroke-linecap="round"></path>
            <circle cx="80" cy={cy + 6} r="1.5" fill="#8ECAF2" fill-opacity="0.45"></circle>
          </g>
        ))}
        <rect x="112" y={centres[0] - 14} width="10" height="24" rx="4" fill="#F3EEE6"></rect>
        <rect x="114.2" y={centres[0] - 11} width="5.6" height="8" rx="2" fill="#FFFDF8" fill-opacity="0.85"></rect>
        <circle cx="78" cy={centres[centres.length - 1] + 30} r="2.2" fill="#3A4046"></circle>
        <text x="130" y="492" text-anchor="middle" fill={word} fill-opacity="0.55" font-family="Manrope, sans-serif" font-size="14" font-weight="650" letter-spacing="2.4">nSedo</text>
      </>
    ) : (
      <>
        <g clip-path={`url(#${uid}-clip)`}>
          <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} fill={`url(#${uid}-wall)`}></rect>
          <circle cx="200" cy="430" r="170" fill={`url(#${uid}-glow)`}></circle>
          <path d="M48 392 H212" stroke="#F4F1EB" stroke-opacity="0.22" stroke-width="1"></path>
        </g>
        <circle cx="130" cy="40" r="7" fill="#050607"></circle>
        <circle cx="130" cy="40" r="5.2" fill="#0E1318"></circle>
        <circle cx="128" cy="38.2" r="1.3" fill="#ffffff" fill-opacity="0.35"></circle>
      </>
    )}
  </svg>
  <span class="visually-hidden"><Text text={label} /></span>
</div>
